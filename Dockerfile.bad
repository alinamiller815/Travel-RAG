# Использование полного образа без необходимости
FROM python:3.10

# Все команды в одном RUN + не очищается apt cache
RUN apt-get update && apt-get install -y \
    build-essential git curl \
    && pip install --upgrade pip \
    && mkdir /app

WORKDIR /app

# Копируем весь проект ДО установки зависимостей
COPY . .

# Обязательное volume
VOLUME ["/app/data"]

# Нет --no-cache-dir
RUN pip install -r requirements.txt

# Нет entrypoint
# Запуск от root
CMD ["python", "-m", "src.main"]
